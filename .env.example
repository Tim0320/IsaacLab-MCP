# Reference only. The server does not load .env files automatically.

# Local Isaac Lab checkout.
ISAACLAB_PATH=D:\IsaacLab

# Optional explicit Isaac Sim path. Isaac Lab's _isaac_sim link is preferred.
ISAAC_SIM_PATH=C:\isaacsim

# Generated training design packets. Keep company-specific data out of Git by default.
# ISAACLAB_MCP_TRAINING_ROOT=F:\IsaacLab-MCP\training_projects

# MCP transport. stdio is the default for local Codex and desktop clients.
ISAACLAB_MCP_TRANSPORT=stdio
ISAACLAB_MCP_HTTP_HOST=127.0.0.1
ISAACLAB_MCP_HTTP_PORT=8010

# Comma-separated exact Host header values allowed by Streamable HTTP.
# MCP_ALLOWED_HOSTS=your-device.your-tailnet.ts.net
